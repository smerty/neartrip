# Copy to .env (or export) when using: docker compose --profile ntrips-dns up -d
#
# NTRIPS listens on host port 2102 with TLS terminated by NearTRIP itself.
# Traefik (80/443) is only for the admin UI and is not involved in NTRIPS.

PUBLIC_HOSTNAME=rtk.example.com
NTRIPS_ACME_EMAIL=you@example.com

# DNS provider code from https://go-acme.github.io/lego/dns/
NTRIPS_DNS_PROVIDER=cloudflare

# Provider credentials (Cloudflare example). Other providers use different vars.
CLOUDFLARE_DNS_API_TOKEN=

# Set to 1 while testing to use the Let's Encrypt staging CA.
NTRIPS_ACME_STAGING=0

# Optional extra lego flags.
# NTRIPS_LEGO_ARGS=--dns.propagation.wait 90s --dns.resolvers 1.1.1.1
