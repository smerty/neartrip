# Copy to .env.ntrips when using: docker compose --profile ntrips-dns up -d
# Compose loads this file into the ntrips-acme container so every lego DNS
# provider credential variable is available (not only Cloudflare).
#
# Also set PUBLIC_HOSTNAME in the Compose project .env (or export it) for the
# ntrip service labels and the optional Traefik cert publisher.
#
# Create the external network once if needed: docker network create traefik

# Lego settings (native names used by brahmadev/acme-lego-cron)
DOMAINS=rtk.example.com
EMAIL_ADDRESS=you@example.com
PROVIDER=cloudflare
STAGING=0
LEGO_ARGS=--dns.resolvers 1.1.1.1

# Provider credentials — keep only what your PROVIDER needs:
# https://go-acme.github.io/lego/dns/
CLOUDFLARE_DNS_API_TOKEN=
# DO_AUTH_TOKEN=
# GANDI_API_TOKEN=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
